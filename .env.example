# Copy to .env.local for local testing, and add the same keys in
# Vercel → Project → Settings → Environment Variables (Production) before going live.

# Canonical site origin used in canonical tags, sitemap, schema (no trailing slash)
NEXT_PUBLIC_SITE_URL=https://medreg.in

# --- Lead form delivery (configure at least one, or leads return an error in production) ---
# Email via Resend (https://resend.com) — verify medreg.in in Resend to use your own sender
RESEND_API_KEY=
LEAD_TO_EMAIL=info@medreg.in
LEAD_FROM_EMAIL=MedReg Website <website@medreg.in>
# Optional: also POST each lead as JSON to Google Sheets (Apps Script), Zapier, Make, Slack, CRM
LEAD_WEBHOOK_URL=

# --- Search Console / Bing Webmaster verification (HTML-tag method: paste only the content value) ---
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
NEXT_PUBLIC_BING_SITE_VERIFICATION=

# --- Google Analytics 4 (optional) — e.g. G-XXXXXXXXXX. Fires a generate_lead event on form success ---
NEXT_PUBLIC_GA_ID=
